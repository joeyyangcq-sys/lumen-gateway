{
  "uid": "lumen-gateway",
  "title": "Lumen Gateway",
  "description": "Request rate, error rate, and upstream latency for lumen-gateway",
  "tags": ["lumen", "gateway"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Request Rate (req/s)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }
      },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "sum(rate(lumen_upstream_requests_total[1m]))",
        "legendFormat": "req/s",
        "refId": "A"
      }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error Rate (5xx %)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": {
        "defaults": { "unit": "percent", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] } }
      },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "100 * sum(rate(lumen_upstream_requests_total{status_class=~\"5..\"}[1m])) / (sum(rate(lumen_upstream_requests_total[1m])) + 0.0001)",
        "legendFormat": "5xx %",
        "refId": "A"
      }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "P95 Latency",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "red", "value": 1 }] } }
      },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "histogram_quantile(0.95, sum by(le) (rate(lumen_upstream_phase_duration_seconds_bucket{phase=\"total\"}[5m])))",
        "legendFormat": "p95",
        "refId": "A"
      }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "P50 Latency",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.2 }, { "color": "red", "value": 0.5 }] } }
      },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "histogram_quantile(0.50, sum by(le) (rate(lumen_upstream_phase_duration_seconds_bucket{phase=\"total\"}[5m])))",
        "legendFormat": "p50",
        "refId": "A"
      }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request Rate by Route",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10 } }
      },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "sum by(route_id) (rate(lumen_upstream_requests_total[1m]))",
        "legendFormat": "{{ route_id }}",
        "refId": "A"
      }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Requests by Status Class",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "5xx" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "4xx" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "2xx" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] }
        ]
      },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "sum by(status_class) (rate(lumen_upstream_requests_total[1m]))",
        "legendFormat": "{{ status_class }}",
        "refId": "A"
      }]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Upstream Latency Percentiles",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 5 } }
      },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by(le) (rate(lumen_upstream_phase_duration_seconds_bucket{phase=\"total\"}[5m])))",
          "legendFormat": "p99", "refId": "A"
        },
        {
          "datasource": { "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by(le) (rate(lumen_upstream_phase_duration_seconds_bucket{phase=\"total\"}[5m])))",
          "legendFormat": "p95", "refId": "B"
        },
        {
          "datasource": { "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by(le) (rate(lumen_upstream_phase_duration_seconds_bucket{phase=\"total\"}[5m])))",
          "legendFormat": "p50", "refId": "C"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Upstream Latency by Phase",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 5 } }
      },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "histogram_quantile(0.95, sum by(le, phase) (rate(lumen_upstream_phase_duration_seconds_bucket[5m])))",
        "legendFormat": "p95 {{ phase }}", "refId": "A"
      }]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Plugin Executions by Plugin",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 5 } }
      },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "sum by(plugin) (rate(lumen_plugin_executions_total[1m]))",
        "legendFormat": "{{ plugin }}", "refId": "A"
      }]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Plugin Duration p95 by Plugin",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 5 } }
      },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "histogram_quantile(0.95, sum by(le, plugin) (rate(lumen_plugin_duration_seconds_bucket[5m])))",
        "legendFormat": "p95 {{ plugin }}", "refId": "A"
      }]
    },
    {
      "id": 11,
      "type": "row",
      "title": "System Runtime",
      "gridPos": { "x": 0, "y": 28, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Goroutine Count",
      "gridPos": { "x": 0, "y": 29, "w": 8, "h": 8 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } }
      },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "go_goroutines",
        "legendFormat": "goroutines",
        "refId": "A"
      }]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Memory Usage",
      "gridPos": { "x": 8, "y": 29, "w": 8, "h": 8 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "lineWidth": 2, "fillOpacity": 10 } }
      },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "go_memstats_heap_alloc_bytes",
          "legendFormat": "heap alloc",
          "refId": "A"
        },
        {
          "datasource": { "uid": "prometheus" },
          "expr": "go_memstats_sys_bytes",
          "legendFormat": "sys",
          "refId": "B"
        },
        {
          "datasource": { "uid": "prometheus" },
          "expr": "go_memstats_stack_inuse_bytes",
          "legendFormat": "stack inuse",
          "refId": "C"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "GC Duration",
      "gridPos": { "x": 16, "y": 29, "w": 8, "h": 8 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 5 } }
      },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "go_gc_duration_seconds{quantile=\"0.75\"}",
          "legendFormat": "gc p75",
          "refId": "A"
        },
        {
          "datasource": { "uid": "prometheus" },
          "expr": "go_gc_duration_seconds{quantile=\"1.0\"}",
          "legendFormat": "gc max",
          "refId": "B"
        }
      ]
    },
    {
      "id": 15,
      "type": "row",
      "title": "Connections & Traffic",
      "gridPos": { "x": 0, "y": 37, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Open Connections",
      "gridPos": { "x": 0, "y": 38, "w": 8, "h": 8 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } }
      },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "sum by(server_id) (http_server_open_connections)",
        "legendFormat": "{{ server_id }}",
        "refId": "A"
      }]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Active Requests",
      "gridPos": { "x": 8, "y": 38, "w": 8, "h": 8 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } }
      },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "http_server_active_requests",
        "legendFormat": "active",
        "refId": "A"
      }]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Traffic In/Out",
      "gridPos": { "x": 16, "y": 38, "w": 8, "h": 8 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": { "unit": "Bps", "custom": { "lineWidth": 2, "fillOpacity": 10 } }
      },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "sum(rate(http_server_request_body_size_total[1m]))",
          "legendFormat": "in",
          "refId": "A"
        },
        {
          "datasource": { "uid": "prometheus" },
          "expr": "sum(rate(http_server_response_body_size_total[1m]))",
          "legendFormat": "out",
          "refId": "B"
        }
      ]
    },
    {
      "id": 19,
      "type": "row",
      "title": "Rate Limiting",
      "gridPos": { "x": 0, "y": 46, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Rate Limit Decisions",
      "gridPos": { "x": 0, "y": 47, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "rejected" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "allowed" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] }
        ]
      },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "sum by(decision) (rate(http_ratelimit_requests_total[1m]))",
        "legendFormat": "{{ decision }}",
        "refId": "A"
      }]
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Rate Limit Rejection Rate",
      "gridPos": { "x": 12, "y": 47, "w": 12, "h": 8 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": {
        "defaults": { "unit": "percent", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 20 }] } }
      },
      "targets": [{
        "datasource": { "uid": "prometheus" },
        "expr": "100 * sum(rate(http_ratelimit_requests_total{decision=\"rejected\"}[1m])) / (sum(rate(http_ratelimit_requests_total[1m])) + 0.0001)",
        "legendFormat": "rejection %",
        "refId": "A"
      }]
    }
  ]
}
